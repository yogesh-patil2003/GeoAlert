# =============================================================================
# GeoAlert — Environment Configuration
# =============================================================================
# Copy this template to `.env` in the `backend/` directory:
#   cp .env.example .env
#
# Fill in the required credentials for satellite providers, databases, and alerting.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ESA Copernicus Data Space Ecosystem (CDSE) / Sentinel-2
# -----------------------------------------------------------------------------
# Register for free at: https://dataspace.copernicus.eu/
# Generate OAuth credentials at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# -----------------------------------------------------------------------------
# 2. Google Earth Engine (GEE)
# -----------------------------------------------------------------------------
# Option A: Place your service account JSON file at `backend/earth_engine_key.json`
# Option B: Or paste the raw JSON string or base64 encoded content below:
EE_SERVICE_ACCOUNT_KEY=

# -----------------------------------------------------------------------------
# 3. OpenWeatherMap API (Optional - Environmental Overlays)
# -----------------------------------------------------------------------------
# Obtain a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# -----------------------------------------------------------------------------
# 4. Database Configuration
# -----------------------------------------------------------------------------
# Defaults to local SQLite if left unset: sqlite:///./database.db
# For production PostgreSQL: postgresql://user:password@localhost:5432/geoalert
DATABASE_URL=sqlite:///./database.db

# -----------------------------------------------------------------------------
# 5. Google Authentication (OAuth 2.0)
# -----------------------------------------------------------------------------
# Google Cloud Console Web Client ID used to verify frontend login tokens
GOOGLE_CLIENT_ID=656796658435-9pn8qg5d8h55dkjtnvr0q3il1tu99u39.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 6. Email Alerts (SMTP)
# -----------------------------------------------------------------------------
# Required for sending automated anomaly & change detection notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_gmail_app_password
ALERT_RECIPIENT=alerts_recipient@example.com

# -----------------------------------------------------------------------------
# 7. Application Settings
# -----------------------------------------------------------------------------
DEBUG=true
